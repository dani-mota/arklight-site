{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/mission", "destination": "/", "permanent": true },
    { "source": "/product", "destination": "/trade-school", "permanent": true },
    { "source": "/hire", "destination": "/content/how-to-hire-industrial-operators", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/talent-factory",
      "destination": "https://talent-factory-xi.vercel.app/talent-factory"
    },
    {
      "source": "/talent-factory/:path*",
      "destination": "https://talent-factory-xi.vercel.app/talent-factory/:path*"
    }
  ],
  "headers": [
    {
      "source": "/((?!talent-factory).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}

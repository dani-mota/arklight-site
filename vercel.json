{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/mission", "destination": "/", "permanent": true },
    { "source": "/product", "destination": "/", "permanent": true },
    { "source": "/world-record", "destination": "/", "permanent": true },
    { "source": "/content-research", "destination": "/research", "permanent": true },
    { "source": "/trade-school", "destination": "/", "permanent": true },
    { "source": "/trade-school/:path*", "destination": "/", "permanent": true },
    { "source": "/high-school", "destination": "/", "permanent": true },
    { "source": "/partners", "destination": "/contact", "permanent": true },
    { "source": "/interest", "destination": "/contact", "permanent": true },
    { "source": "/privacy-terms", "destination": "/privacy-policy", "permanent": true },
    { "source": "/cipher-live", "destination": "/", "permanent": true },
    { "source": "/cipher-live/:path*", "destination": "/", "permanent": true },
    { "source": "/infrastructure", "destination": "/", "permanent": true },
    { "source": "/insights", "destination": "/", "permanent": true },
    { "source": "/data-room-assets/:path*", "destination": "/data-room", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/data-room/activity",
      "destination": "/data-room-activity"
    },
    {
      "source": "/talent-factory",
      "destination": "https://talent-factory-xi.vercel.app/talent-factory"
    },
    {
      "source": "/talent-factory/:path*",
      "destination": "https://talent-factory-xi.vercel.app/talent-factory/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/talent-factory/:path*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/api/doc",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/data-room-activity",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/data-room/activity",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
